# Server Configuration
PORT=8080
NODE_ENV=production

# Redis Configuration (Memorystore for Redis on GCP or Upstash/Redis Cloud)
# Format: redis://[:password@]host:port[/db-number]
REDIS_URL=redis://10.0.0.3:6379

# Or specify separate parameters:
# REDIS_HOST=10.0.0.3
# REDIS_PORT=6379
# REDIS_PASSWORD=your_secure_redis_password
